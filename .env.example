# Local Ollama defaults
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=ollama

# To use OpenAI instead, set LLM_BASE_URL=https://api.openai.com/v1,
# choose an OpenAI model, and put the key below.
# OPENAI_API_KEY=sk-...

PROFILE_NAME=Amit Kumar

# Optional Pushover notifications
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional Gradio server settings
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Optional safety limits (seconds/rounds)
MODEL_TIMEOUT_SECONDS=60
PUSHOVER_TIMEOUT_SECONDS=10
MAX_TOOL_ROUNDS=5
